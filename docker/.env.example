# pi-kot docker configuration template
# Copy to .env: cp .env.example .env, then: docker compose up -d --build

# --- Identity (match `id -u` / `id -g` for writable bind mounts) ---
PUID=1000
PGID=1000

# --- Port ---
HOST_PORT=3333

# --- Workspace & Persistence Paths ---
WORKSPACE_HOST_PATH=./workspace
PI_CONFIG_HOST_PATH=~/.pi/agent
KOT_DATA_HOST_PATH=~/.pi-kot-docker

# --- Auth (both empty = auth disabled; set before exposing publicly) ---
UI_PASSWORD=
API_KEY=

# --- Sudo Privileges for user pi ---
# false: No sudo access (default locked-down)
# true:  Scoped sudo for apt, apt-get, dpkg (safest for installing packages)
# all:   Full passwordless sudo for all commands
ENABLE_SUDO=false

# --- Optional build packages (space-separated) ---
# Extra system packages to bake into the image during build
# e.g. EXTRA_APT_PACKAGES="ffmpeg libnss3 libglib2.0-0 libcups2 libx11-6"
EXTRA_APT_PACKAGES=

# --- Logging / reverse proxy ---
LOG_LEVEL=info
TRUST_PROXY=false

# --- Agent tool sandbox overlay (see docker-compose.sandbox.yml) ---
AGENT_TOOL_SANDBOX_ENABLED=false
AGENT_TOOL_UID=1001
AGENT_TOOL_GID=1001
AGENT_TOOL_HOME=/home/pi-tools
AGENT_TOOL_SANDBOX_CHOWN_PATHS=

# --- Container name ---
CONTAINER_NAME=pi-kot
